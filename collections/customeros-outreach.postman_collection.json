              "raw": "{\n  \"campaignId\": \"<string>\",\n  \"generateUnsubscribeLink\": \"<boolean>\",\n  \"links\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"messageId\": \"<string>\",\n  \"recipientId\": \"<string>\",\n  \"trackClicks\": \"<boolean>\",\n  \"trackOpens\": \"<boolean>\",\n  \"trackerDomain\": \"<string>\",\n  \"unsubscribeLink\": \"<string>\"\n}",
