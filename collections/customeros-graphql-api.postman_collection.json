  "item": [
    {
      "id": "d9a97bef-9b21-4fac-9260-a15243a7e85a",
      "name": "GraphQL",
      "description": {
        "content": "Single GraphQL endpoint for all CustomerOS operations.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "f2a18765-2ed2-454e-ae6f-37c07decb024",
          "name": "Execute a GraphQL query or mutation.",
          "request": {
            "name": "Execute a GraphQL query or mutation.",
            "description": {
              "content": "Single GraphQL endpoint served by gqlgen. Accepts a standard GraphQL POST body (query, optional operationName, optional variables) and returns a GraphQL response envelope with `data` and/or `errors`. Authenticated per tenant with an API key header. Most fields are protected by @hasRole and @hasTenant directives in the schema.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "query"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "X-Openline-API-KEY"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"<string>\",\n  \"operationName\": \"<string>\",\n  \"variables\": {\n    \"key_0\": \"string\",\n    \"key_1\": false\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "f4209e56-7535-4fa8-96cd-05aa572126ac",
              "name": "GraphQL response. Note that GraphQL returns HTTP 200 even when the response contains field-level `errors`.",
              "originalRequest": {
                "url": {
                  "path": [
                    "query"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: apikey",
                      "type": "text/plain"
                    },
                    "key": "X-Openline-API-KEY",
                    "value": "<API Key>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"query\": \"query($id: ID!) {\\n  organization(id: $id) {\\n    metadata { id }\\n    name\\n    website\\n  }\\n}\\n\",\n  \"variables\": {\n    \"id\": \"org-123\"\n  }\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"data\": {\n    \"key_0\": true,\n    \"key_1\": false\n  },\n  \"errors\": [\n    {\n      \"message\": \"string\",\n      \"path\": [\n        \"string\",\n        \"string\"\n      ],\n      \"extensions\": {\n        \"key_0\": false,\n        \"key_1\": 7696\n      }\n    },\n    {\n      \"message\": \"string\",\n      \"path\": [\n        \"string\",\n        \"string\"\n      ],\n      \"extensions\": {\n        \"key_0\": 5405.687400826947,\n        \"key_1\": 9583.599322458895\n      }\n    }\n  ]\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
            },
